# Copy to .env and fill in. Never commit .env.

# LLM provider: anthropic | gateway | fake
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
# Only used when LLM_PROVIDER=gateway (OpenAI-compatible endpoint)
GATEWAY_BASE_URL=
GATEWAY_API_KEY=

# BigQuery (auth comes from gcloud Application Default Credentials)
GCP_PROJECT=
BQ_DATASET=reabasto
# bigquery | duckdb
ENGINE=duckdb

# API: comma-separated user:key pairs, e.g. ana:KEY1,luis:KEY2
API_KEYS=
SQLITE_PATH=data/reabasto.sqlite
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
